# ==============================================================================
# Sable Base — Package List
# ==============================================================================
# Core system packages required for a functional Sable CLI installation.
# Comments (#) and blank lines are ignored during package processing.

# Init System & Service Manager
systemd
systemd-sysv

# Core Utilities & Shell
bash
coreutils
util-linux
zstd
cpio

# Privilege & User Management
sudo
passwd

# Networking
iproute2
iputils-ping
network-manager
wpasupplicant
curl
wget
ca-certificates
firmware-linux
firmware-linux-free
firmware-misc-nonfree
firmware-amd-graphics
intel-microcode
amd64-microcode

# System Diagnostics & Process Tools
procps
psmisc
less
nano
vim-tiny

# Locale, keyboard & session support
locales
keyboard-configuration
console-setup
libpam-systemd

# Hardening extras (always in the base; pentest tools are netinstall-only)
apparmor
apparmor-profiles
auditd
ufw
libpam-pwquality

# System Info Presentation
fastfetch
